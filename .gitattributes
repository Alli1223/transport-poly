# Auto detect text files and perform LF normalization
* text=auto

*.cpp text eol=lf
*.hpp text eol=lf
*.h   text eol=lf
*.c   text eol=lf
*.glsl text eol=lf
*.cmake text eol=lf
CMakeLists.txt text eol=lf
*.md  text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.sh  text eol=lf
*.bat text eol=crlf
*.ps1 text eol=crlf

*.png binary
*.ttf binary
*.tpsave binary
