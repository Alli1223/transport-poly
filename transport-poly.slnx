<?xml version="1.0" encoding="UTF-8"?>
<!--
  Visual Studio 2026 solution for transport-poly.

  The projects are generated by CMake: run scripts\open-vs.bat once (it
  configures the windows-vs2026 preset and opens this file). CMake keeps the
  projects up to date afterwards: the ZERO_CHECK project re-runs it whenever a
  CMakeLists.txt changes.
-->
<Solution>
  <Configurations>
    <BuildType Name="Debug" />
    <BuildType Name="RelWithDebInfo" />
    <BuildType Name="Release" />
    <BuildType Name="MinSizeRel" />
    <Platform Name="x64" />
  </Configurations>
  <Folder Name="/Game/">
    <Project Path="build/windows-vs2026/src/transport-poly.vcxproj" DefaultStartup="true">
      <BuildDependency Project="build/windows-vs2026/ZERO_CHECK.vcxproj" />
      <BuildDependency Project="build/windows-vs2026/_deps/glfw-build/src/glfw.vcxproj" />
      <BuildDependency Project="build/windows-vs2026/tp_imgui.vcxproj" />
      <BuildDependency Project="build/windows-vs2026/src/tp_core.vcxproj" />
      <BuildDependency Project="build/windows-vs2026/src/tp_sim.vcxproj" />
      <BuildDependency Project="build/windows-vs2026/src/tp_net.vcxproj" />
      <BuildDependency Project="build/windows-vs2026/src/tp_render.vcxproj" />
    </Project>
    <Project Path="build/windows-vs2026/src/transport-poly-server.vcxproj">
      <BuildDependency Project="build/windows-vs2026/ZERO_CHECK.vcxproj" />
      <BuildDependency Project="build/windows-vs2026/src/tp_core.vcxproj" />
      <BuildDependency Project="build/windows-vs2026/src/tp_sim.vcxproj" />
      <BuildDependency Project="build/windows-vs2026/src/tp_net.vcxproj" />
    </Project>
  </Folder>
  <Folder Name="/Libraries/">
    <Project Path="build/windows-vs2026/src/tp_core.vcxproj">
      <BuildDependency Project="build/windows-vs2026/ZERO_CHECK.vcxproj" />
    </Project>
    <Project Path="build/windows-vs2026/src/tp_sim.vcxproj">
      <BuildDependency Project="build/windows-vs2026/ZERO_CHECK.vcxproj" />
      <BuildDependency Project="build/windows-vs2026/src/tp_core.vcxproj" />
    </Project>
    <Project Path="build/windows-vs2026/src/tp_net.vcxproj">
      <BuildDependency Project="build/windows-vs2026/ZERO_CHECK.vcxproj" />
      <BuildDependency Project="build/windows-vs2026/src/tp_core.vcxproj" />
      <BuildDependency Project="build/windows-vs2026/src/tp_sim.vcxproj" />
    </Project>
    <Project Path="build/windows-vs2026/src/tp_render.vcxproj">
      <BuildDependency Project="build/windows-vs2026/ZERO_CHECK.vcxproj" />
      <BuildDependency Project="build/windows-vs2026/src/tp_core.vcxproj" />
      <BuildDependency Project="build/windows-vs2026/src/tp_sim.vcxproj" />
    </Project>
  </Folder>
  <Folder Name="/Tests/">
    <Project Path="build/windows-vs2026/tests/tp_tests.vcxproj">
      <BuildDependency Project="build/windows-vs2026/ZERO_CHECK.vcxproj" />
      <BuildDependency Project="build/windows-vs2026/src/tp_core.vcxproj" />
      <BuildDependency Project="build/windows-vs2026/src/tp_sim.vcxproj" />
      <BuildDependency Project="build/windows-vs2026/src/tp_net.vcxproj" />
    </Project>
  </Folder>
  <Folder Name="/Third party/">
    <Project Path="build/windows-vs2026/_deps/glfw-build/src/glfw.vcxproj">
      <BuildDependency Project="build/windows-vs2026/ZERO_CHECK.vcxproj" />
    </Project>
    <Project Path="build/windows-vs2026/tp_imgui.vcxproj">
      <BuildDependency Project="build/windows-vs2026/ZERO_CHECK.vcxproj" />
      <BuildDependency Project="build/windows-vs2026/_deps/glfw-build/src/glfw.vcxproj" />
    </Project>
  </Folder>
  <Folder Name="/CMake/">
    <Project Path="build/windows-vs2026/ZERO_CHECK.vcxproj" />
    <Project Path="build/windows-vs2026/ALL_BUILD.vcxproj">
      <BuildDependency Project="build/windows-vs2026/ZERO_CHECK.vcxproj" />
      <BuildDependency Project="build/windows-vs2026/src/transport-poly.vcxproj" />
      <BuildDependency Project="build/windows-vs2026/src/transport-poly-server.vcxproj" />
      <BuildDependency Project="build/windows-vs2026/tests/tp_tests.vcxproj" />
    </Project>
    <Project Path="build/windows-vs2026/RUN_TESTS.vcxproj">
      <BuildDependency Project="build/windows-vs2026/ZERO_CHECK.vcxproj" />
      <Build Solution="*|*" Project="false" />
    </Project>
    <Project Path="build/windows-vs2026/PACKAGE.vcxproj">
      <BuildDependency Project="build/windows-vs2026/ALL_BUILD.vcxproj" />
      <BuildDependency Project="build/windows-vs2026/ZERO_CHECK.vcxproj" />
      <Build Solution="*|*" Project="false" />
    </Project>
  </Folder>
  <Folder Name="/Solution Items/">
    <File Path="CMakeLists.txt" />
    <File Path="CMakePresets.json" />
    <File Path="README.md" />
    <File Path="TODO.md" />
    <File Path="docs/ARCHITECTURE.md" />
    <File Path=".github/workflows/ci.yml" />
  </Folder>
</Solution>
