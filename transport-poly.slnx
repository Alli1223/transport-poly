
<!--
  Visual Studio 2026 solution for transport-poly.

  The projects are generated by CMake: run scripts\open-vs.bat once (it
  configures the windows-vs2026 preset and opens this file). Until then every
  project shows as "not found". CMake keeps the projects up to date afterwards:
  the ZERO_CHECK project re-runs it whenever a CMakeLists.txt changes.

  Visual Studio writes each project's Id here when it saves this file. CMake
  derives those GUIDs from the absolute path of the build tree, so a checkout
  in another folder gets different Ids; Visual Studio rewrites them on save.
-->
<Solution>
  <Configurations>
    <BuildType Name="Debug" />
    <BuildType Name="RelWithDebInfo" />
    <BuildType Name="Release" />
    <BuildType Name="MinSizeRel" />
    <Platform Name="x64" />
  </Configurations>
  <Folder Name="/Game/">
