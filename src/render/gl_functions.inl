// X-macro list of the OpenGL 3.3 core entry points used by the renderer.
// TP_GL_FN(return type, name, parameter list)
// Entries marked TP_GL_FN_OPTIONAL may be missing (extensions / newer versions).

// State
TP_GL_FN(const GLubyte*, glGetString, (GLenum name))
TP_GL_FN(void, glGetIntegerv, (GLenum pname, GLint* data))
TP_GL_FN(void, glGetFloatv, (GLenum pname, GLfloat* data))
TP_GL_FN(GLenum, glGetError, (void))
TP_GL_FN(void, glEnable, (GLenum cap))
TP_GL_FN(void, glDisable, (GLenum cap))
TP_GL_FN(void, glBlendFunc, (GLenum sfactor, GLenum dfactor))
TP_GL_FN(void, glBlendFuncSeparate, (GLenum srcRGB, GLenum dstRGB, GLenum srcAlpha, GLenum dstAlpha))
TP_GL_FN(void, glBlendEquation, (GLenum mode))
TP_GL_FN(void, glDepthFunc, (GLenum func))
TP_GL_FN(void, glDepthMask, (GLboolean flag))
TP_GL_FN(void, glColorMask, (GLboolean r, GLboolean g, GLboolean b, GLboolean a))
TP_GL_FN(void, glCullFace, (GLenum mode))
TP_GL_FN(void, glFrontFace, (GLenum mode))
TP_GL_FN(void, glViewport, (GLint x, GLint y, GLsizei width, GLsizei height))
