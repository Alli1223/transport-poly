TP_GL_FN(void, glPixelStorei, (GLenum pname, GLint param))
TP_GL_FN(void, glReadPixels, (GLint x, GLint y, GLsizei width, GLsizei height, GLenum format, GLenum type, void* pixels))
TP_GL_FN(void, glFinish, (void))
TP_GL_FN(void, glFlush, (void))

